# Запрет прямого доступа к конфигу с токенами
<Files "config.php">
	Require all denied
</Files>
<Files "config.example.php">
	Require all denied
</Files>

# /api/order → order.php (если Apache + mod_rewrite)
<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteBase /api/
	RewriteRule ^order/?$ order.php [L,QSA]
</IfModule>
